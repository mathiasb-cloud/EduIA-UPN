# --- IA (Google Gemini) ---
GEMINI_API_KEY=
EDUIA_MODELO_RAPIDO=gemini-3.5-flash-lite
EDUIA_MODELO_PROFUNDO=gemini-3.6-flash

# --- WhatsApp (Twilio) ---
TWILIO_SID=
TWILIO_TOKEN=
# Número emisor habilitado para WhatsApp en Twilio, con prefijo whatsapp:
TWILIO_WHATSAPP_FROM=whatsapp:+
# Opcional: plantilla aprobada (Content API) con la variable {{1}} para avisos fuera de la ventana de 24 h
TWILIO_CONTENT_SID=
# Número que se usa si el alumno no configuró el suyo en la extensión
WHATSAPP_DESTINO_PREDETERMINADO=
# 0 para no enviar el WhatsApp de confirmación al programar un recordatorio
EDUIA_CONFIRMAR_WHATSAPP=1
EDUIA_ZONA_HORARIA=America/Lima

# --- Scripts de scraping (opcional) ---
BB_USER=
BB_PASS=
